# AI 分析配置

# AI API 基础地址（必填）
AI_BASE_URL=https://api-inference.modelscope.cn
# API 密钥（必填）
AI_API_KEY=your-api-key-here
# 模型名称（必填）
AI_MODEL=ZhipuAI/GLM-5.1

# 批次并发数
AI_CONCURRENCY=3
# 核查模式：修正作者信息（false 关闭）
AI_VERIFY=true
# 每批处理数量
AI_BATCH_SIZE=60
# 采样温度
AI_TEMPERATURE=0.1
# 最大重试次数
AI_MAX_RETRIES=3
# 重试间隔（毫秒）
AI_RETRY_DELAY=2000
# 侵权资源过滤：扫描后自动过滤非公有领域资源（false 关闭）
AI_COPYRIGHT_FILTER=true
